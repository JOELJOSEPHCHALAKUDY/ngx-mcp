{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/integration*.ts"
  ],
  "exclude": [
    "experiments",
    "test-apps",
    "dist",
    "artifacts",
    "node_modules"
  ]
}
