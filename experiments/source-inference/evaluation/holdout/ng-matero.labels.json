 {
  "id": "update-appearance-settings",
  "component": "Customizer",
  "handler": "sendOptions",
  "routes": [
   "/"
  ],
  "inputSchema": {
   "type": "object",
   "properties": {
    "theme": {
     "type": "string",
     "enum": [
      "light",
      "dark",
      "auto"
     ]
    },
    "showHeader": {
     "type": "boolean"
    },
    "headerPos": {
     "type": "string",
     "enum": [
      "above",
      "fixed",
      "static"
     ]
    },
    "showUserPanel": {
     "type": "boolean"
    },
    "navPos": {
     "type": "string",
     "enum": [
      "side",
      "top"
     ]
    },
    "dir": {
     "type": "string",
     "enum": [
      "ltr",
      "rtl"
     ]
    }
   },
   "required": []
  },
  "validInput": {
   "theme": "dark",
   "navPos": "side"
  },
  "effect": "Emits optionsChange -> AdminLayout.updateOptions; persists settings, applies direction and theme.",
  "notes": "Reachable via floating settings FAB opening drawer; each control change triggers it. Constraints: headerPos 'above' disabled when navPos=top or header hidden; navPos 'top' disabled if headerPos=above or header hidden."
 },
