 {
  "id": "remote-search",
  "component": "TablesRemoteData",
  "handler": "search",
  "routes": [
   "/tables/remote-data"
  ],
  "inputSchema": {
   "type": "object",
   "properties": {
    "q": {
     "type": "string"
    },
    "sort": {
     "type": "string",
     "enum": [
      "stars",
      "forks",
      "updated"
     ]
    },
    "order": {
     "type": "string",
     "enum": [
      "desc",
      "asc"
     ]
    }
   },
   "required": []
  },
  "validInput": {
   "q": "user:nzbin",
   "sort": "stars",
   "order": "desc"
  },
  "effect": "Resets to page 0 and queries GitHub repository search API.",
  "notes": ""
 },
 {
  "id": "remote-reset",
  "component": "TablesRemoteData",
  "handler": "reset",
  "routes": [
   "/tables/remote-data"
  ],
  "inputSchema": {
   "type": "object",
   "properties": {},
   "required": []
  },
  "validInput": {},
