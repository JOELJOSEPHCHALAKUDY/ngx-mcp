  },
  "effect": "Changes page/page size and re-queries GitHub API.",
  "notes": ""
 },
 {
  "id": "dynamic-form-submit",
  "component": "FormsDynamic",
  "handler": "submit",
  "routes": [
   "/forms/dynamic"
  ],
  "inputSchema": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string",
     "minLength": 1
    },
    "text2": {
     "type": "string"
    },
    "email": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "text",
    "email"
   ]
  },
  "validInput": {
   "text": "hello",
   "email": "email@gmail.com"
  },
  "effect": "If valid, shows success toast with model JSON.",
  "notes": "No server call. text2 enabled only when text non-empty."
 },
 {
  "id": "dynamic-form2-submit",
  "component": "FormsDynamic",
  "handler": "submit2",
  "routes": [
   "/forms/dynamic"
  ],
  "inputSchema": {
   "type": "object",
   "properties": {
    "firstName": {
     "type": "string",
     "minLength": 1
    },
    "lastName": {
     "type": "string",
     "minLength": 1
    },
    "street": {
     "type": "string"
    },
    "cityId": {
     "type": "integer",
     "enum": [
      1,
      2,
      3,
      4
     ]
    },
    "zip": {
     "type": "integer",
     "minimum": 0,
     "maximum": 99999,
     "pattern": "\\d{5}"
    },
    "otherInput": {
     "type": "string"
    },
    "otherToo": {
     "type": "boolean"
    }
   },
   "required": [
    "firstName",
    "lastName",
    "cityId"
   ]
  },
  "validInput": {
   "firstName": "A",
   "lastName": "B",
   "cityId": 1,
   "zip": 12345
  },
  "effect": "If valid, shows success toast with model JSON.",
  "notes": "No server call. lastName enabled only after firstName."
 },
