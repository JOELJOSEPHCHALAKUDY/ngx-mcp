[
 {
  "id": "login",
  "component": "Login",
  "handler": "login",
  "routes": [
   "/auth/login"
  ],
  "inputSchema": {
   "type": "object",
   "properties": {
    "username": {
     "type": "string",
     "minLength": 1
    },
    "password": {
     "type": "string",
     "minLength": 1
    },
    "rememberMe": {
     "type": "boolean"
    }
   },
   "required": [
    "username",
    "password"
   ]
  },
  "validInput": {
   "username": "ng-matero",
   "password": "ng-matero",
   "rememberMe": false
  },
  "effect": "Authenticates via AuthService.login, stores token, navigates to /.",
  "notes": "Form defaults prefilled to ng-matero; 422 maps remote errors onto fields."
 },
