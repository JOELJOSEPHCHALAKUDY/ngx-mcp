      "id": "filter_todos",
      "description": "Read all, active or completed todo rows using the real hash router",
      "route": "/#/all",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "enum": [
              "all",
              "active",
              "completed"
            ]
          }
        },
        "required": [
          "filter"
        ],
        "additionalProperties": false
      },
      "validInput": {
        "filter": "active"
      },
      "trigger": {
        "type": "routerLink",
        "selectors": {
          "all": ".filters a[href=\"#/\"]",
          "active": ".filters a[href=\"#/active\"]",
          "completed": ".filters a[href=\"#/completed\"]"
        }
      },
      "effect": {
        "observable": [
          "All shows every todo; Active only completed=false; Completed only completed=true",
          "Selected filter class changes",
          "Filtering preserves underlying data and active count"
        ]
      },
