    {
      "id": "edit_todo",
      "description": "Double-click a row label, edit title, then commit by Enter or blur",
      "route": "/#/all",
      "kind": "update",
      "inputSchema": {
        "type": "object",
        "properties": {
          "todo": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "completed": {
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "completed"
            ],
            "additionalProperties": false
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "todo",
          "title"
        ],
        "additionalProperties": false
      },
      "validInput": {
        "todo": {
          "title": "Read fixture article",
          "completed": false
        },
        "title": "  Revised fixture article  "
      },
      "trigger": {
        "type": "workflow",
        "reveal": {
          "event": "dblclick",
          "selector": "app-todo-item label"
        },
        "field": "input.edit",
        "commitEvents": [
          "keyup.enter",
          "blur"
        ],
        "handler": "TodoItemComponent.commitEdit"
      },
      "effect": {
        "observable": [
          "Nonblank title is trimmed and replaces selected todo title",
          "Completed state is preserved",
          "Editing UI closes",
          "Blank/whitespace edit removes selected todo"
        ]
      },
