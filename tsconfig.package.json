  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": [
    "src/index.ts",
    "src/integrate.ts",
    "src/integrated-serve.ts"
